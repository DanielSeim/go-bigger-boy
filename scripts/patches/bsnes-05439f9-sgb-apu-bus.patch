diff --git a/bsnes/sfc/dsp/dsp.cpp b/bsnes/sfc/dsp/dsp.cpp
--- a/bsnes/sfc/dsp/dsp.cpp
+++ b/bsnes/sfc/dsp/dsp.cpp
@@ -14,2 +14,33 @@
 static std::vector<DiagnosticSoundEvent> diagnosticSoundEvents;
+struct DiagnosticApuEvent { uint64 fields[7]; };
+static std::vector<DiagnosticApuEvent> diagnosticApuEvents;
+static bool diagnosticApuOverflow = false;
+extern "C" unsigned gbb_reference_sgb_apu_bus_version() { return 1; }
+extern "C" unsigned gbb_reference_sgb_apu_bus_count() {
+  return diagnosticApuOverflow ? 0xffffffffu : diagnosticApuEvents.size();
+}
+extern "C" unsigned gbb_reference_sgb_apu_bus_frequencies(uint64* output) {
+  if(!output) return 0;
+  output[0] = cpu.frequency;
+  output[1] = smp.frequency;
+  return 1;
+}
+extern "C" unsigned gbb_reference_sgb_apu_bus_copy(unsigned index, uint64* output) {
+  if(!output || index >= diagnosticApuEvents.size()) return 0;
+  for(unsigned i = 0; i < 7; ++i) output[i] = diagnosticApuEvents[index].fields[i];
+  return 1;
+}
+extern "C" void gbb_reference_sgb_record_apu_bus(unsigned kind, unsigned address, unsigned value) {
+  if(icd.diagnosticSoundCount < 2) return;
+  if(diagnosticFirstKonSample != 0xffffffffu &&
+      diagnosticDspSamples.size() / 2 >= diagnosticFirstKonSample + 27234) return;
+  if(kind == 'R' && (address < 0xf4 || address > 0xf7)) return;
+  if(kind == 'W' && address != 0xf1 && address != 0xf3 &&
+      (address < 0xf4 || address > 0xf7)) return;
+  if(kind == 'W' && address == 0xf3 && smp.diagnosticDspAddress() == 0x4c) kind = 'K';
+  if(diagnosticApuEvents.size() >= 262144) { diagnosticApuOverflow = true; return; }
+  diagnosticApuEvents.push_back({{kind, cpu.diagnosticMasterClocks(), smp.diagnosticHalfClocks,
+    static_cast<uint64>(diagnosticDspSamples.size() / 2), address, value,
+    static_cast<uint64>(dsp.diagnosticKeyPollClock())}});
+}
 
