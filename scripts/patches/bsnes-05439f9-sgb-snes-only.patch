+extern "C" void gbb_reference_sgb_record_ram_write(unsigned address, unsigned value) {
+  const unsigned sample = diagnosticDspSamples.size() / 2;
+  if(diagnosticFirstKonSample != 0xffffffffu &&
+      sample >= diagnosticFirstKonSample + 22428 &&
+      sample < diagnosticFirstKonSample + 27234 &&
+      diagnosticSoundEvents.size() < 32768)
+    diagnosticSoundEvents.push_back({3, address, value, sample, 0, 0});
+}
+
+extern "C" void gbb_reference_sgb_record_host_write(unsigned port, unsigned value,
+    unsigned vertical, unsigned horizontal) {
+  // This local Donkey Kong replay's first audible packet is SOUND index 1.
+  if(icd.diagnosticSoundCount >= 2 && diagnosticSoundEvents.size() < 32768)
+    diagnosticSoundEvents.push_back({1, port, value,
+                                     static_cast<unsigned>(diagnosticDspSamples.size() / 2),
+                                     vertical, horizontal});
+}
+
+extern "C" unsigned gbb_reference_sgb_event_count() {
+  return diagnosticSoundEvents.size();
+}
+
+extern "C" unsigned gbb_reference_sgb_event_copy(unsigned index, unsigned* output) {
+  if(index >= diagnosticSoundEvents.size() || !output) return 0;
+  const auto& event = diagnosticSoundEvents[index];
+  output[0] = event.kind;
+  output[1] = event.address;
+  output[2] = event.value;
+  output[3] = event.dspFrame;
+  output[4] = event.vertical;
+  output[5] = event.horizontal;
+  return 1;
+}
+
+extern "C" unsigned gbb_reference_sgb_dsp_sample_count() {
+  return diagnosticDspOverflow ? 0xffffffffu : diagnosticDspSamples.size() / 2;
+}
+
+extern "C" unsigned gbb_reference_sgb_dsp_copy(unsigned start, unsigned count,
+    int16_t* output) {
+  if(!output || diagnosticDspOverflow || start > diagnosticDspSamples.size() / 2 ||
+      count > diagnosticDspSamples.size() / 2 - start) return 0;
+  for(unsigned i = 0; i < count * 2; i++) output[i] = diagnosticDspSamples[start * 2 + i];
+  return 1;
+}
+
+extern "C" unsigned gbb_reference_sgb_ram_copy(uint8_t* output, unsigned count) {
+  if(!output || count != 65536) return 0;
+  memcpy(output, dsp.apuram, count);
+  return 1;
+}

