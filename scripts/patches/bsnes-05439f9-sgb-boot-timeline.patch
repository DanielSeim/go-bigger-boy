diff --git a/bsnes/sfc/dsp/gbb_boot_probe.hpp b/bsnes/sfc/dsp/gbb_boot_probe.hpp
new file mode 100644
--- /dev/null
+++ b/bsnes/sfc/dsp/gbb_boot_probe.hpp
@@ -0,0 +1,74 @@
+// Original, opt-in bounded diagnostic instrumentation; never release runtime.
+struct DiagnosticBootEvent { uint64 fields[7]; };
+static std::vector<DiagnosticBootEvent> diagnosticBootEvents;
+static bool diagnosticBootEnabled = false, diagnosticBootOverflow = false;
+static bool diagnosticBootEntry = false, diagnosticBootTransfer = false;
+static bool diagnosticBootAudible = false, diagnosticBootCommand = false;
+static bool diagnosticBootIplA = false, diagnosticBootIplReady = false;
+static uint8 diagnosticBootPorts[4] = {}, diagnosticBootIndex = 0;
+static unsigned diagnosticBootDestination = 0, diagnosticBootLength = 0;
+static uint64 diagnosticBootDigest = 14695981039346656037ull;
+extern "C" unsigned gbb_reference_sgb_boot_version() { return 1; }
+extern "C" unsigned gbb_reference_sgb_boot_enable(unsigned enabled) {
+  diagnosticBootEnabled = enabled != 0;
+  diagnosticBootEvents.clear();
+  diagnosticBootEvents.reserve(128);
+  diagnosticBootOverflow = diagnosticBootEntry = diagnosticBootTransfer = false;
+  diagnosticBootAudible = diagnosticBootCommand = false;
+  diagnosticBootIplA = diagnosticBootIplReady = false;
+  for(auto& p : diagnosticBootPorts) p = 0;
+  diagnosticBootIndex = diagnosticBootDestination = diagnosticBootLength = 0;
+  diagnosticBootDigest = 14695981039346656037ull;
+  return 1;
+}
+extern "C" unsigned gbb_reference_sgb_boot_count() {
+  return diagnosticBootOverflow ? 0xffffffffu : diagnosticBootEvents.size();
+}
+extern "C" unsigned gbb_reference_sgb_boot_copy(unsigned index, uint64* output) {
+  if(!output || index >= diagnosticBootEvents.size()) return 0;
+  for(unsigned i = 0; i < 7; ++i) output[i] = diagnosticBootEvents[index].fields[i];
+  return 1;
+}
+extern "C" void gbb_reference_sgb_record_boot(unsigned kind, uint64 master, uint64 value, uint64 count, uint64 digest) {
+  if(!diagnosticBootEnabled) return;
+  if(diagnosticBootEvents.size() == 128) { diagnosticBootOverflow = true; return; }
+  if(kind == 'S') {
+    const auto a = value & 255, b = value >> 8 & 255, control = value >> 16 & 255, score = value >> 24 & 255;
+    if((control & 12) != 12 && ((a && a < 128) || (b && b < 128) || score)) diagnosticBootAudible = true;
+  }
+  diagnosticBootEvents.push_back({{kind, master, smp.diagnosticHalfClocks, value, count, digest, 0}});
+}
+static void diagnosticBootHost(unsigned address, unsigned value) {
+  if(!diagnosticBootEnabled) return;
+  const unsigned port = address & 3;
+  if(diagnosticBootAudible && !diagnosticBootCommand && port == 0 && value == 1) {
+    diagnosticBootCommand = true;
+    gbb_reference_sgb_record_boot('P', cpu.diagnosticMasterClocks(), value, 0, 0);
+  }
+  if(diagnosticBootEntry) return;
+  diagnosticBootPorts[port] = value;
+  if(!diagnosticBootTransfer) {
+    if(port == 0 && value == 0xcc && diagnosticBootPorts[1] == 1) {
+      diagnosticBootTransfer = true;
+      diagnosticBootDestination = diagnosticBootPorts[2] | diagnosticBootPorts[3] << 8;
+      gbb_reference_sgb_record_boot('A', cpu.diagnosticMasterClocks(), diagnosticBootDestination, 0, 0);
+    }
+    return;
+  }
+  if(port != 0) return;
+  if(value == diagnosticBootIndex) {
+    diagnosticBootDigest = (diagnosticBootDigest ^ diagnosticBootPorts[1]) * 1099511628211ull;
+    ++diagnosticBootLength;
+    ++diagnosticBootIndex;
+  } else if(value == uint8(diagnosticBootIndex + 1)) {
+    if(!diagnosticBootLength) { diagnosticBootOverflow = true; return; }
+    gbb_reference_sgb_record_boot('U', cpu.diagnosticMasterClocks(), diagnosticBootDestination, diagnosticBootLength, diagnosticBootDigest);
+    diagnosticBootDestination = diagnosticBootPorts[2] | diagnosticBootPorts[3] << 8;
+    if(diagnosticBootPorts[1] == 0) {
+      diagnosticBootEntry = true;
+      gbb_reference_sgb_record_boot('E', cpu.diagnosticMasterClocks(), diagnosticBootDestination, 0, 0);
+    }
+    diagnosticBootLength = diagnosticBootIndex = 0;
+    diagnosticBootDigest = 14695981039346656037ull;
+  } else diagnosticBootOverflow = true;
+}
