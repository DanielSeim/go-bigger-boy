#include <windows.h>

1 VERSIONINFO
FILEVERSION @GBB_WINDOWS_NUMERIC_VERSION@,0
PRODUCTVERSION @GBB_WINDOWS_NUMERIC_VERSION@,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "@GBB_WINDOWS_FILE_DESCRIPTION@\0"
            VALUE "FileVersion", "@GAMEBOY_DESKTOP_VERSION@\0"
            VALUE "InternalName", "@GBB_WINDOWS_INTERNAL_NAME@\0"
            VALUE "OriginalFilename", "@GBB_WINDOWS_INTERNAL_NAME@.exe\0"
            VALUE "ProductName", "Go Bigger Boy\0"
            VALUE "ProductVersion", "@GAMEBOY_DESKTOP_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
